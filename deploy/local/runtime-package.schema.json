{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leapview.flid.ai/schemas/local-runtime-package-v1.json",
  "title": "LeapView local runtime package",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "persistentStateSchemaVersion",
    "composeMinimumVersion",
    "leapview",
    "postgres"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "persistentStateSchemaVersion": {
      "const": 1
    },
    "composeMinimumVersion": {
      "const": "2.17.0"
    },
    "leapview": {
      "$ref": "#/$defs/leapview"
    },
    "postgres": {
      "$ref": "#/$defs/postgres"
    }
  },
  "$defs": {
    "leapview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "revision", "image"],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "image": {
          "type": "string",
          "pattern": "^[^@\\s]+@sha256:[0-9a-f]{64}$"
        }
      }
    },
    "postgres": {
      "type": "object",
      "additionalProperties": false,
      "required": ["major", "image"],
      "properties": {
        "major": {
          "const": 18
        },
        "image": {
          "const": "docker.io/library/postgres:18-alpine@sha256:77f585114c32fbca283dc835b0596f4e52b51b4c6662d7810b2f4084f60a1873"
        }
      }
    }
  }
}
