  "runtime": "Isolated localhost, durable Local Developer administrator and equivalent Demo Audit account",
  "productionChecked": false,
  "issues": [
    {
      "id": "PERM-01",
      "title": "Explorer has no selectable data",
      "problem": "An active Explorer role could discover semantic metadata, but Data Explorer displayed zero objects.",
      "fix": "Expose authorized semantic datasets without source/model metadata or development grants. Selection, Rows and Analyze use governed semantic queries. Metric-only analyses switch to valid record fields and discard aggregate-only sorting and metric filters.",
      "before": [
        "before-explorer-empty.png"
      ],
      "after": [
        "after-explorer-datasets.png",
        "after-explorer-records.png",
        "after-explorer-query.png",
        "after-explorer-metric-only.png",
        "after-explorer-metric-to-rows.png",
        "after-explorer-mobile.png",
        "after-explorer-mobile-filters.png"
      ],
      "status": "Fixed"
    },
    {
      "id": "PERM-02",
      "title": "Private-draft wording overstates owner isolation",
      "problem": "The creation dialog promised private owner-only access although authorized Editors can access the draft.",
      "fix": "Creation dialogs, catalog status and the authoring guide explain access by authorized editors. Existing dashboard authorization remains unchanged.",
      "before": [
        "before-draft-wording.png"
      ],
      "after": [
        "after-draft-wording.png"
      ],
      "status": "Fixed"
    },
    {
      "id": "UI-03",
      "title": "Unavailable roles can be selected for a grant",
      "problem": "Publisher and Release Approver were selectable although the administrator lacked the permissions needed to delegate them.",
      "fix": "The picker disables unavailable roles and explains the missing permission. The server independently repeats its existing grant checks; supported administrator grants still activate immediately.",
      "before": [
        "before-publisher-selectable.png"
      ],
      "after": [
        "after-grant-picker.png",
        "after-admin-grant-success.png"
      ],
      "status": "Fixed"
    },
    {
      "id": "UI-04",
      "title": "Failed grant shows stale success feedback",
      "problem": "A rejected Publisher grant appeared beside the old successful Viewer grant message and exposed confusing internal credential wording.",
      "fix": "Access patches clear transient feedback, errors take display priority, and denied role grants use the current readable eligibility reason.",
      "before": [
        "before-stale-grant-feedback.png"
      ],
      "after": [
        "after-grant-failure-only.png"
      ],
      "status": "Fixed"
    },
    {
      "id": "UI-05",
      "title": "Read-only users are offered editable dashboard copies",
      "problem": "Viewer catalog menus, details drawers and dashboard report menus exposed copy actions that creation permissions rejected.",
      "fix": "Request-backed catalog and report controls use creation authority. Readers retain details and copy-link controls; authorized Editors retain editable-copy controls. Mutation authorization is unchanged.",
      "before": [
        "before-viewer-copy-menu.png",
        "before-viewer-report-copy.png"
      ],
      "after": [
        "after-viewer-copy-menu.png",
        "after-viewer-details.png",
        "after-viewer-report.png",
        "after-editor-copy-menu.png",
        "after-editor-report-menu.png"
      ],
      "status": "Fixed"
    },
    {
      "id": "UI-06",
      "title": "Read-only dashboard details expose appearance editing",
      "problem": "Viewer details offered Change icon although the appearance mutation was unauthorized.",
      "fix": "Request-backed documents expose the appearance editor and command bridge only when the same management authorization as the mutation succeeds. Readers retain the appearance summary.",
      "before": [
        "before-viewer-appearance.png"
      ],
      "after": [
        "after-viewer-appearance.png"
      ],
      "status": "Fixed"
    },
    {
      "id": "UI-07",
      "title": "Profile edits disappear on reload",
      "problem": "Title and Username accepted edits entirely in browser state and reset after reload.",
      "fix": "Unsupported fields are explicitly read-only, with clear descriptions. Display name remains editable; its persistence was manually checked and the original name restored. Editable title/username persistence is not implemented.",
      "before": [
        "before-profile-unsaved-fields.png",
        "before-profile-reloaded.png"
      ],
      "after": [
        "after-profile-readonly-fields.png",
        "after-profile-mobile.png",
        "after-profile-tablet.png"
      ],
      "status": "Fixed"
    }
  ],
